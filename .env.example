# Anthropic Claude API configuration
# Get your key from https://console.anthropic.com/
# Copy this file to `.env` and replace the placeholder with your real key.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Default Claude model used across the tutorials.
# Options: claude-opus-4-7, claude-sonnet-4-6, claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-sonnet-4-6

TAVILY_API_KEY=tvly-dev-your-tavily-key-here
HF_TOKEN=hf_your_hf_token_here

